
#include "main.h"

int main() {

	FILE *fptrCode;

	FILE *fptrCmd;
	FILE *fptrDat;
	FILE *fptrAdr;

	/* Open the code */
	ifstream fptrCode("code.txt", "r");

	/* Create the hex files for programming the computer */
	ofstream fptrCmd("cmd.hex", "w"); //cmd and dat in one file, since they are combined in one flash chip
	ofstream fptrAdr("adr.hex", "w");

	string newLine;
	getline(fptrCode, newLine);

	list<Cmd> Commands;

	list<Cmd>::iterator Iterator;

	Cmd Jump;
	Jump.Init("jmp", 0x01);
	Commands.insert(Iterator, Jump);


	/* Close the files */
	fclose(fptrCode);
	fclose(fptrCmd);
	fclose(fptrAdr);
}
