
#include "main.h"

using namespace std;

int main() {

	FILE *fptrCode;

	FILE *fptrCmd;
	FILE *fptrDat;
	FILE *fptrAdr;

	// Open the code
	fptrCode = fopen("code.txt", "r");

	// Create the hex files for programming the computer
	fptrCmd = fopen("cmd.hex", "w");
	fptrDat = fopen("dat.hex", "w");
	fptrAdr = fopen("adr.hex", "w");

	char newLine[LINELENGTH];
	fgets(newLine, LINELENGTH, fptrCode);




	// Close the files
	fclose(fptrCode);
	fclose(fptrCmd);
	fclose(fptrDat);
	fclose(fptrAdr);
}
