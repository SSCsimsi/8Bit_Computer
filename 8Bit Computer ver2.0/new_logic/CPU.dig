    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>commands requiring the data bus to be disabled:
Storage: 
- load

ALU:
- add
- add with carry
- subtract

incrementor:
- increment
- decrement

logic:
- binary not
- binary or
- binary and
- binary xor
- bitwise not
- bitwise or
- bitwise and
- bitwise xor

a/b/c registers:
- load a
- load b
- load c

compare:
- bigger
- equal
- smaller

flag reg:
- load carry
- load overflow
- load flags</string>
        </entry>
      </elementAttributes>
